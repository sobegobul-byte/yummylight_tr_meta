[Unit]
Description=Finansal Kader paneli
After=network-online.target

[Service]
User=opc
WorkingDirectory=/opt/finansal-kader
Environment=TZ=Europe/Istanbul
ExecStart=/opt/finansal-kader/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8102
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
